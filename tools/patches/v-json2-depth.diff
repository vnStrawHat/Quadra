+// max_depth caps the nesting of arrays and objects (quadra patch, json2 depth).
+const max_depth = 256
+
+@[markused]
+fn (mut checker Decoder) enter() ! {
+	checker.depth++
+	if checker.depth > max_depth {
+		checker.checker_error('nested deeper than ${max_depth} levels')!
+	}
+}
+
 @[markused]
 fn (mut checker Decoder) check_array() ! {
+	checker.enter()!
+	defer {
+		checker.depth--
+	}
 	checker.increment('expected array end')!
 
 	checker.skip_whitespace('expected array end')!
