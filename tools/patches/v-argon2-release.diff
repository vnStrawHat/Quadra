 		init_hash(password, salt, secret, data, time, effective_memory, threads_u32, key_len, mode)!
 	mut blocks := init_blocks(h0, effective_memory, threads_u32)!
 	process_blocks(mut blocks, time, effective_memory, threads_u32, mode)
-	return extract_key(mut blocks, effective_memory, threads_u32, key_len)
+	key := extract_key(mut blocks, effective_memory, threads_u32, key_len) or {
+		release_blocks(mut blocks)
+		return err
+	}
+	release_blocks(mut blocks)
+	return key
+}
+
+// quadra patch (argon2 release): the memory-hard buffer (64 MiB by default) lives in the C
+// heap, wiped and freed as soon as the key is out. On the collector's heap a block that large
+// was kept alive by any stale word pointing into it, and tcc's prebuilt collector never
+// returns memory to the OS, so one vault unlock kept 64 MiB for good.
+fn new_blocks(n int) []u64 {
+	mut blocks := []u64{}
+	unsafe {
+		blocks.data = C.calloc(usize(n), 8)
+		if blocks.data == nil {
+			panic('argon2: out of memory')
+		}
+		blocks.len = n
+		blocks.cap = n
+		blocks.flags.set(.nogrow | .nofree)
+	}
+	return blocks
+}
+
+fn release_blocks(mut blocks []u64) {
+	unsafe {
+		C.memset(blocks.data, 0, usize(blocks.len) * 8)
+		C.free(blocks.data)
+	}
+	blocks = []u64{}
 }
 
