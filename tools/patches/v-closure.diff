--- vlib/builtin/closure/closure.c.v
+++ vlib/builtin/closure/closure.c.v
@@ -136,6 +136,14 @@
         0x7d, 0x89, 0x03, 0xa6,	// mtctr  %r12
         0x4e, 0x80, 0x04, 0x20,	// bctr
     ]!
+} $else $if amd64 && windows {
+    // quadra patch (win64 closure abi): xmm15 is callee-saved on Win64, so optimized callers keep
+    // floats in it across closure calls and the thunk corrupted them. xmm5 is volatile and never
+    // carries arguments in the Win64 convention. Same length (REX 0x40), same rip offsets.
+    [
+    u8(0xF3), 0x40, 0x0F, 0x7E, 0x2D, 0xF7, 0xBF, 0xFF, 0xFF,  // movq  xmm5, QWORD PTR [rip - userdata]
+        0xFF, 0x25, 0xF9, 0xBF, 0xFF, 0xFF                     // jmp  QWORD PTR [rip - fn]
+    ]!
 } $else $if amd64 {
     [
     u8(0xF3), 0x44, 0x0F, 0x7E, 0x3D, 0xF7, 0xBF, 0xFF, 0xFF,  // movq  xmm15, QWORD PTR [rip - userdata]
@@ -238,6 +246,11 @@
         0x04, 0x00, 0x10, 0xE5,  // ldr r0, [r0, #-4]
         0x1E, 0xFF, 0x2F, 0xE1   // bx lr
     ]!
+} $else $if amd64 && windows {
+    [
+    u8(0x66), 0x48, 0x0F, 0x7E, 0xE8,  // movq rax, xmm5 (quadra patch, see the thunk)
+        0xC3                           // ret
+    ]!
 } $else $if amd64 {
     [
     u8(0x66), 0x4C, 0x0F, 0x7E, 0xF8,  // movq rax, xmm15
@@ -870,3 +883,9 @@
 	closure_release_no_lock(exec_ptr, 0)
 	closure_mtx_unlock_platform()
 }
+
+// live_closures returns how many closures are allocated and not yet released
+// (quadra patch: lets bench/leak see closure leaks).
+pub fn live_closures() int {
+	return g_closure.live.len
+}
